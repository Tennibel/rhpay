# RH Pay Solutions - configuración de Apache (HostGator)
# Súbelo a la raíz del sitio (public_html), junto a index.html.

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Siempre HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://rhpaysolutions.com.mx%{REQUEST_URI} [L,R=301]

  # 2) Sin "www"
  RewriteCond %{HTTP_HOST} ^www\.rhpaysolutions\.com\.mx$ [NC]
  RewriteRule ^ https://rhpaysolutions.com.mx%{REQUEST_URI} [L,R=301]

  # 3) Redirecciones 301 del sitio anterior al nuevo.
  #    Agrega aquí una línea por cada dirección vieja, por ejemplo:
  #    Redirect 301 /nosotros.html https://rhpaysolutions.com.mx/acerca-de/
  #    (pendiente: falta la lista de URL del sitio actual)
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

# Caché del navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Seguridad básica
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddDefaultCharset UTF-8

# Archivos internos: no se pueden abrir desde el navegador
<FilesMatch "^(config-correo.*\.php|enviar-errores\.log)$">
  Require all denied
</FilesMatch>
